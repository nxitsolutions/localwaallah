# Database password used by docker-compose.yml (pick a long random one).
POSTGRES_PASSWORD=change-me

# From Firebase console > Project settings > General > Your apps > Web app config.
# These are public identifiers, not secrets; the server sends them to the app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=
