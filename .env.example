# Database password used by docker-compose.yml (pick a long random one).
POSTGRES_PASSWORD=change-me

# From Firebase console > Project settings > General > Your apps > Web app config.
# These are public identifiers, not secrets; the server sends them to the app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project
FIREBASE_APP_ID=

# Optional: Google Maps key for the map on the Route screen (see server/README.md, step 3).
# Without it the Route screen shows a simple sketch and still opens directions in Google Maps.
GOOGLE_MAPS_API_KEY=

# Optional: NX Control Tower project key. New vendor accounts are reported to the central dashboard
# (only the vendor's Firebase uid and sign-in method are sent). Leave empty to turn it off.
NX_PROJECT_KEY=
